# Los documentos firmados NO se sirven directamente por HTTP: se entregan
# desde admin/ver_adjunto.php, que exige haber iniciado sesion. PHP lee el
# archivo del disco, asi que esta restriccion no afecta al panel.
Require all denied

# Segunda barrera por si el servidor ignorara la regla anterior: ningun
# archivo subido puede ejecutarse como script.
php_flag engine off
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
# Deshabilita handlers de scripts por si el servidor usa CGI/FastCGI
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pht|phar|cgi|pl|py|sh|htaccess)$">
    Require all denied
</FilesMatch>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar
AddType text/plain .php .phtml .phar
# Sin listado de directorio
Options -Indexes -ExecCGI
